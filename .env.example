# Copy to .env.local for local development and add the same values in Vercel
# (Settings → Environment Variables). Never commit real values.

# Public URL of the site (used for metadata, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://praxis-digital-gemacht.de

# Resend (contact form)
RESEND_API_KEY=
# Address that receives enquiries
CONTACT_TO_EMAIL=
# Verified sender in Resend, e.g. "Praxis digital gemacht <hallo@praxis-digital-gemacht.de>"
CONTACT_FROM_EMAIL=

# Sanity (blog and Praxis-Ratgeber). Leave empty until the Sanity project exists:
# the site then simply shows no posts or guides.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Motion+ (install-time only, see https://motion.dev/docs/react-motion-plus-installation)
# MOTION_TOKEN=
